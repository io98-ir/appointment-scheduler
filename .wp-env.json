{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"core": null,
	"phpVersion": "8.1",
	"plugins": [ "." ],
	"config": {
		"WP_DEBUG": true,
		"WP_DEBUG_LOG": true,
		"WP_DEBUG_DISPLAY": false,
		"SCRIPT_DEBUG": true,
		"WP_ENVIRONMENT_TYPE": "local"
	},
	"env": {
		"development": {
			"port": 8888
		},
		"tests": {
			"port": 8889,
			"config": {
				"WP_DEBUG_DISPLAY": true
			}
		}
	}
}
