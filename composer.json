{
    "name": "io98-ir/vaqtyar",
    "description": "Appointment booking for WordPress.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
        "woocommerce/action-scheduler": "^3.9"
    },
    "require-dev": {
        "ext-intl": "*",
        "brain/monkey": "^2.6",
        "deptrac/deptrac": "^2.0",
        "mockery/mockery": "^1.6",
        "php-stubs/woocommerce-stubs": "^11.1",
        "php-stubs/wordpress-tests-stubs": "^7.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6",
        "slevomat/coding-standard": "^8.15",
        "squizlabs/php_codesniffer": "^3.10",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.1",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Vaqtyar\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vaqtyar\\Tests\\": "tests/",
            "Vaqtyar\\Tools\\": "tools/"
        }
    },
    "scripts": {
        "lint": [
            "phpcs --standard=tools/phpcs.xml",
            "phpcs --standard=tools/phpcs-legacy.xml"
        ],
        "lint:fix": "phpcbf --standard=tools/phpcs.xml",
        "stan": "phpstan analyse -c tools/phpstan.neon --memory-limit=1G --no-progress",
        "deptrac": [
            "deptrac analyse --config-file=tools/deptrac-layers.yaml --no-progress",
            "deptrac analyse --config-file=tools/deptrac-modules.yaml --no-progress"
        ],
        "test": "@test:unit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit -c phpunit-integration.xml.dist",
        "check": [
            "@lint",
            "@stan",
            "@deptrac",
            "@test:unit"
        ],
        "test:rename": [
            "Composer\\Config::disableProcessTimeout",
            "@php tools/test-rename.php"
        ]
    },
    "scripts-descriptions": {
        "lint": "PHPCS: PSR-12 + WPCS security/i18n (ADR-008), and PHP 7.0 syntax for the bootstrap files.",
        "lint:fix": "Fix what PHPCBF can fix automatically.",
        "stan": "PHPStan level 9 with WordPress stubs.",
        "deptrac": "Layer and module boundaries.",
        "test:unit": "PHPUnit unit suite (no WordPress).",
        "test:integration": "PHPUnit integration suite: real WordPress and MySQL. Run it inside wp-env (docs/04-engineering/02-dev-environment.md).",
        "check": "Everything CI runs locally: lint, stan, deptrac, unit tests.",
        "test:rename": "Rename a copy of the plugin and run composer check on it (ADR-000)."
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    }
}
