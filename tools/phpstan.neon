# Paths are relative to this file. Never write the repo's absolute path here
# unquoted: it contains parentheses (implementation-notes §2).
includes:
    - ../vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 9
    paths:
        - ../src
        - ../tests
        - ../tools
        - ../vaqtyar.php
        - ../uninstall.php
    scanFiles:
        # WP_UnitTestCase and tests_add_filter() for tests/Integration.
        - ../vendor/php-stubs/wordpress-tests-stubs/wordpress-tests-stubs.php
        # as_schedule_recurring_action() and the rest of Action Scheduler's API (ADR-005).
        - ../vendor/woocommerce/action-scheduler/functions.php
    tmpDir: ../.phpstan.cache
